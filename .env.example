# Copie este arquivo para ".env" e preencha os valores.
# O arquivo ".env" NUNCA vai para o Git.

# Chave secreta do Django (gere uma nova; veja o README)
SECRET_KEY=

# True só em desenvolvimento. Em produção use False.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# HTTPS: deixe vazio (liga sozinho quando DEBUG=False).
# Use False só para testar localmente com DEBUG=False (ex.: ver a página 404).
SECURE_HTTPS=

# Banco MySQL
DB_NAME=elegancia_crista
DB_USER=elegancia
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Dados da loja
WHATSAPP_NUMBER=5511985335054
CONTACT_EMAIL=elegancia.crist@gmail.com

# Identificação do fornecedor (Decreto 7.962/2013, art. 2º; decisão 85).
# A loja ainda não tem CNPJ: deixe VAZIO. O site mostra "[A DEFINIR PELA DONA]".
# Quando houver CNPJ, preencha. NUNCA coloque CPF nem endereço residencial.
STORE_LEGAL_NAME=
STORE_CNPJ=
STORE_ADDRESS=

# E-mail (verificação de conta e "esqueci a senha").
# Em desenvolvimento, deixe vazio: os e-mails aparecem no terminal do runserver.
# O envio de verdade (Brevo, por SMTP) será configurado depois (decisão 62).
EMAIL_BACKEND=
DEFAULT_FROM_EMAIL=
